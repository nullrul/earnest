+"""OpenSpec host (SPIKE D prototype): a change under `openspec/changes/<id>/` as an intent, and `tasks.md` checkboxes.
+
+Not production code: it exists to settle what marks an intent, where its route comes from, and where a task's box is.
+"""
+
+import json
+import re
+import shutil
+import subprocess  # noqa: S404
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+from pathlib import PurePosixPath
+
+ARCHIVE = "archive"
+
+# Port of upstream's TASK_LINE_PATTERN (src/utils/task-progress.ts, v2.1.1): any list marker, a box holding at most one
+# non-space marker, only `x` or `X` is done, and a `[x](...)` or `[x][...]` link bullet is no box.
+TASK_LINE = re.compile(r"\s*(?:[-*+]|\d{1,9}[.)])\s*\[(?:\s*([^\]\s]?)\s*\](?![(\[])|\s+\])\s*(.*)")
+
+
+@dataclass(frozen=True)
+class Artifact:
+    """One artifact of a schema: its id, the glob its output matches (relative to the change), and what it needs."""
+
+    id: str
+    generates: str
+    requires: tuple[str, ...] = ()
+
+
+# Source 1: the built-in `spec-driven` schema as upstream's schemas/spec-driven/schema.yaml gives it (v2.1.1).
+SPEC_DRIVEN = (
+    Artifact("proposal", "proposal.md"),
+    Artifact("specs", "specs/**/*.md", ("proposal",)),
+    Artifact("design", "design.md", ("proposal",)),
+    Artifact("tasks", "tasks.md", ("specs", "design")),
+)
+
+
+def change_dirs(paths: Iterable[str]) -> frozenset[str]:
+    """Return the change directories among the listed paths: `<...>/openspec/changes/<id>` outside `archive/`.
+
+    Upstream's own rule (src/utils/item-discovery.ts getActiveChangeIds): every directory directly under
+    `openspec/changes/` except `archive` and the hidden ones. No marker file is needed.
+    """
+    found: set[str] = set()
+    for path in paths:
+        parts = PurePosixPath(path).parts
+        for at in range(len(parts) - 3):
+            if parts[at : at + 2] == ("openspec", "changes"):
+                name = parts[at + 2]
+                if name != ARCHIVE and not name.startswith("."):
+                    found.add("/".join(parts[: at + 3]))
+                break
+    return frozenset(found)
+
+
+def route_files() -> tuple[Artifact, ...]:
+    """Source 1: the route as a constant, whatever schema the change names."""
+    return SPEC_DRIVEN
+
+
+def route_cli(directory: str, root: str) -> tuple[tuple[Artifact, ...], str]:
+    """Source 2: the route from `openspec status --change <id> --json`: the schema name and its artifacts in order.
+
+    Raises:
+        RuntimeError: `openspec` is not on PATH or fails (the M9 feature must fail loud, see #26).
+    """
+    exe = shutil.which("openspec")
+    if exe is None:
+        msg = "openspec is not on PATH"
+        raise RuntimeError(msg)
+    name = PurePosixPath(directory).name
+    done = subprocess.run(  # noqa: S603
+        [exe, "status", "--change", name, "--json"], cwd=root, capture_output=True, text=True, check=False, timeout=60
+    )
+    if done.returncode != 0:
+        msg = f"openspec status failed for {name}: {done.stderr.strip()[:200]}"
+        raise RuntimeError(msg)
+    data = json.loads(done.stdout)
+    artifacts = tuple(
+        Artifact(each["id"], each["outputPath"], tuple(each["requires"])) for each in data["artifacts"]
+    )
+    return artifacts, data["schemaName"]
+
+
+def _glob(pattern: str) -> re.Pattern[str]:
+    out, at = "", 0
+    while at < len(pattern):
+        if pattern.startswith("**/", at):
+            out, at = out + "(?:.*/)?", at + 3
+        elif pattern.startswith("**", at):
+            out, at = out + ".*", at + 2
+        elif pattern[at] == "*":
+            out, at = out + "[^/]*", at + 1
+        else:
+            out, at = out + re.escape(pattern[at]), at + 1
+    return re.compile(out)
+
+
+def matches(directory: str, generates: str, path: str) -> bool:
+    """Return whether path is an output of the artifact that `generates` names, inside the change directory."""
+    prefix = directory + "/"
+    return path.startswith(prefix) and _glob(generates).fullmatch(path[len(prefix) :]) is not None
+
+
+def box(lines: Sequence[tuple[int, str]]) -> tuple[int, bool] | None:
+    """Return the line and state of the first checkbox among the (number, text) lines, or None: `x`/`X` is checked."""
+    for number, text in lines:
+        found = TASK_LINE.match(text)
+        if found:
+            return number, (found.group(1) or "").lower() == "x"
+    return None
